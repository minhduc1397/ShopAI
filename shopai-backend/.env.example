# ============================================
# ShopAI Backend — Bản mẫu biến môi trường
# Cách dùng: copy .env.example thành .env rồi điền giá trị thật vào .env
# File .env KHÔNG BAO GIỜ được commit. File .env.example thì PHẢI commit.
# ============================================

# Cổng Server lắng nghe. Nhớ dùng cùng cổng này trong API_BASE_URL bên Mobile.
PORT=3000

# Trợ lý AI — Google Gemini: https://aistudio.google.com/app/apikey (có gói miễn phí)
GEMINI_API_KEY=
# Model chính; quá tải / hết hạn mức thì tự chuyển lần lượt sang GEMINI_FALLBACK_MODELS
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.8-flash

# Chuỗi bí mật ký JWT — đặt một chuỗi ngẫu nhiên dài
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Chuỗi kết nối Database Prisma (SQLite: file nằm trong thư mục prisma/)
DATABASE_URL="file:./dev.db"
