# Copy thành keystore.properties (KHÔNG commit) rồi điền mật khẩu thật.
# Tạo keystore: keytool -genkeypair -v -storetype PKCS12 -keystore app/shopai-release.keystore -alias shopai-release -keyalg RSA -keysize 2048 -validity 10000
storeFile=shopai-release.keystore
storePassword=
keyAlias=shopai-release
keyPassword=
